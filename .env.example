# =============================================================================
# Environment template — copy to `.env.local` and fill in.
#
#   cp .env.example .env.local
#
# `.env.local` (and any `.env*`) is git-ignored; ONLY this template is tracked.
# NEVER put real keys in this file.
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Project URL, e.g. https://<ref>.supabase.co
#   Public (browser-safe). Also read at build time to widen the CSP
#   img-src / connect-src to your project — must be set BEFORE `next build`.
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key.
#   Public (browser-safe) — constrained by Row Level Security; reads published
#   content only. Required for the admin panel and real content.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS.
#   Used only by `persistOrder` (server-only) to write checkout orders, which
#   anon cannot touch. In production the checkout REFUSES orders if this is
#   missing (it will not silently drop them). Never prefix with NEXT_PUBLIC_,
#   never import into a client component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL ------------------------------------------------------------------
# Origin for canonical URLs / Open Graph / sitemap / robots. Protocol optional
# (https assumed). SERVER ONLY — do NOT add a NEXT_PUBLIC_ copy; it is never
# needed in the browser and the public variant would be inlined into the client
# bundle at build time.
#   Read on every server render: robots/sitemap are force-dynamic (per request);
#   the marketing pages carry it through ISR and refresh it within their
#   revalidate window. Changing the domain needs a redeploy or one revalidation
#   cycle — never a code rebuild.
#   On Vercel, set this in Project Settings for ALL environments so it is also
#   present at build time. If unset it falls back to
#   VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL, then http://localhost:3000.
#   No domain is hardcoded anywhere.
SITE_URL=

# --- Checkout throttle (optional, server only) --------------------------------
# Limit on the anonymous COD checkout action. Defaults used when unset.
# CHECKOUT_RATE_MAX=6            # attempts per client IP per window
# CHECKOUT_RATE_WINDOW_MS=60000  # window length
# CHECKOUT_RATE_GLOBAL_MAX=300   # attempts across ALL IPs per window (Upstash only)

# --- Distributed rate limiting (optional, server only) -----------------------
# Set BOTH to make the checkout throttle distributed across serverless
# instances (Upstash Redis REST — free tier is enough). Without them the
# throttle is in-process only. Create a database at console.upstash.com and
# copy the "REST API" URL + token. Server-only — never NEXT_PUBLIC_.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
