# Copy to .env.local and fill in. .env.local is git-ignored.
# Without these the app runs on MockContentRepository (in-memory sample data) —
# every page still works, content just isn't editable.

# --- Site URL (SEO) ----------------------------------------------------------
# The site's public origin, used for canonical URLs, Open Graph tags, the
# sitemap and robots.txt. Set this to the real domain in production, e.g.
# maisonlumiere.com (protocol optional — https is assumed). Read at runtime, so
# changing it only needs a restart, not a rebuild. Until it is set (and outside
# Vercel, which supplies its own URL), everything falls back to
# http://localhost:3000 — no domain is hardcoded anywhere.
SITE_URL=

# --- Supabase (public) ---------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe to expose to the browser — it is constrained by
# Row Level Security (see supabase/migrations). Reads published content only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server only — NEVER prefix with NEXT_PUBLIC_) -------------------
# Service-role key. Bypasses RLS. Used server-side only, to write checkout
# orders (public.orders / order_items, which anon cannot touch). Without it the
# checkout still completes and logs the order server-side but nothing is
# persisted. Must never reach client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Checkout throttle (server only, optional) --------------------------------
# In-process sliding-window limit on the anonymous COD checkout action. Defaults
# below are used when unset. This is per-instance only — it is NOT a distributed
# rate limiter (that needs Upstash / Vercel KV, or Turnstile/hCaptcha on the
# form, neither of which is wired up here).
CHECKOUT_RATE_MAX=6
CHECKOUT_RATE_WINDOW_MS=60000
